{
  "manifest_version": 3,
  "name": "AI Visibility & Competitive Threat Radar",
  "version": "1.0",
  "description": "Live SERP AI visibility and competitive threat detection.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://serpapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
